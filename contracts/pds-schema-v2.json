        }
      ]
    }
  },
  "rules": {
    "date": "YYYY-MM-DD; Asia/Seoul calendar dates",
    "timestamp": "UTC ISO 8601; display Asia/Seoul",
    "unit": "integer minutes",
    "actualMinutes": "round((endAt-startAt)/60000); positive",
    "period": "inclusive task due_date range, selected plan, deleted=0",
    "planned": "count eligible tasks",
    "completed": "count eligible tasks where done=1",
    "late": "count eligible tasks where done=0 and due_date < Seoul today",
    "blocked": "count distinct eligible task IDs with a nonblank blocker",
    "expected": "sum eligible task estimated_minutes",
    "actual": "sum execution_logs.actual_minutes for eligible tasks",
    "delta": "actual-expected; empty sums = 0",
    "planRevisions": "snapshot of pre-update plan, appended atomically with plan update",
    "completion": "task_id primary key; INSERT OR IGNORE; undo deletes completion row",
    "logIdempotency": "execution_logs.id primary key; retry retains UUID",
    "review": "next plan and review inserted atomically; improvement copied verbatim",
    "deletion": "soft delete tasks; retained in JSON export; excluded from aggregates",
    "legacy": "entries retained in export for compatibility; not included in v2 aggregates"
  }
}